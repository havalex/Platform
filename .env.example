# Copy to .env for local dev (docker compose sets these in containers)

DATABASE_URL=postgres://forge:forge@localhost:5432/forge
REDIS_URL=redis://localhost:6379
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=forge
MINIO_SECRET_KEY=forgeforgeforge
MINIO_BUCKET=forge-assets
MINIO_USE_SSL=false

API_PORT=4000
ADMIN_URL=http://localhost:5173
RUNTIME_URL=http://localhost:5174

# Vite apps (copy to apps/admin/.env and apps/runtime/.env if needed)
VITE_FORGE_RUNTIME_URL=http://localhost:5174
VITE_FORGE_ADMIN_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Bootstrap (first tenant + site) — change in production
FORGE_BOOTSTRAP_TENANT=default
FORGE_BOOTSTRAP_SITE=main
FORGE_ADMIN_API_KEY=dev-change-me
